{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkfin-site",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "inkfin.maurya.ie", "custom_domain": true }],
}
